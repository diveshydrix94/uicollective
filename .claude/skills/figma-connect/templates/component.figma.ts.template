// CANONICAL Code Connect v2 TEMPLATE file (what `npm run cc:migrate` produces from
// the authored {{Name}}.figma.tsx). This is the file v2 parses & publishes. You do NOT
// normally hand-write this — author the .figma.tsx and let the gate migrate it. Kept
// here as the reference shape (and a fallback if `figma connect migrate` is ever gone).
//
// Header comments below are load-bearing: migrate stamps url / source / component.
// url=<FIGMA_NODE_URL>
// source=<GITHUB_URL_TO_{{Name}}.tsx>
// component={{Name}}

import figma from "figma" // virtual module the CLI injects — NOT a real dependency.
                          // Do not add it to package.json; keep .figma.ts out of tsconfig's typecheck if it ever complains.

// Each Figma property → a template variable via figma.selectedInstance.*:
const label = figma.selectedInstance.getString("Label")
const variant = figma.selectedInstance.getEnum("Type", { default: "default" })
const size = figma.selectedInstance.getEnum("Size", { default: "default", md: "md", lg: "lg" })
const disabled = figma.selectedInstance.getEnum("Status", { disabled: true, default: false })
// BOOLEAN + instance-swap → nested template's rendered example (or undefined when off):
const iconLeft = figma.selectedInstance.getBoolean("Icon left", {
  true: figma.selectedInstance.getInstanceSwap("↘ Icon left")?.executeTemplate().example,
  false: undefined,
})

export default {
  id: "{{Name}}",
  imports: ["import { {{Name}} } from './{{Name}}';"],
  // figma.code`` is a tagged template; interpolate props via the react helpers so
  // absent props drop out cleanly. renderChildren() emits text/nested content.
  example: figma.code`<{{Name}}${figma.helpers.react.renderProp("variant", variant)}${figma.helpers.react.renderProp("size", size)}${figma.helpers.react.renderProp("disabled", disabled)}${figma.helpers.react.renderProp("iconLeft", iconLeft)}>
      ${figma.helpers.react.renderChildren(label)}
    </{{Name}}>`,
  metadata: { nestable: true },
}
